<?php
/** @var \Magento\CatalogWidget\Block\Product\ProductsList $block */
/** @var \Magento\Framework\Escaper $escaper */

use Magento\Framework\App\ActionInterface;

$collection = $block->getProductCollection();
if (!$collection || !$collection->count()) {
    return;
}
?>
<section class="mw-collection" id="home-new-arrivals">
    <div class="mw-collection__head">
        <h2 class="mw-section-title"><?= $escaper->escapeHtml(__($block->getTitle())) ?></h2>
        <a class="mw-link" href="<?= $escaper->escapeUrl($block->getBaseUrl() . ltrim((string)$block->getData('more_path'), '/')) ?>">
            <?= $escaper->escapeHtml(__('Voir plus')) ?>
        </a>
    </div>
    <ol class="mw-collection__track">
        <?php foreach ($collection->getItems() as $item): ?>
            <?php $url = $block->getProductUrl($item); ?>
            <li class="mw-card">
                <div class="mw-card__visual">
                <a href="<?= $escaper->escapeUrl($url) ?>" class="mw-card__media" tabindex="-1" aria-hidden="true">
                    <?= $block->getImage($item, 'new_products_content_widget_grid')->toHtml() ?>
                </a>
                <?php if ($item->isSaleable()): ?>
                    <?php $postParams = $block->getAddToCartPostParams($item); ?>
                    <form class="mw-card__quickadd" data-role="tocart-form"
                          data-product-sku="<?= $escaper->escapeHtmlAttr($item->getSku()) ?>"
                          action="<?= $escaper->escapeUrl($postParams['action']) ?>" method="post">
                        <input type="hidden" name="product"
                               value="<?= $escaper->escapeHtmlAttr($postParams['data']['product']) ?>">
                        <input type="hidden" name="<?= /* @noEscape */ ActionInterface::PARAM_NAME_URL_ENCODED ?>"
                               value="<?= $escaper->escapeHtmlAttr($postParams['data'][ActionInterface::PARAM_NAME_URL_ENCODED]) ?>">
                        <?= $block->getBlockHtml('formkey') ?>
                        <button type="submit" class="action tocart primary">
                            <?= $escaper->escapeHtml(__('Ajouter au panier')) ?>
                        </button>
                    </form>
                <?php endif; ?>
                </div>
                <div class="mw-card__body">
                    <a class="mw-card__name" href="<?= $escaper->escapeUrl($url) ?>">
                        <?= $escaper->escapeHtml($item->getName()) ?>
                    </a>
                    <div class="mw-card__price">
                        <?= /* @noEscape */ $block->getProductPriceHtml($item, 'final_price') ?>
                    </div>
                    <?php if (!$item->isSaleable()): ?>
                        <span class="mw-card__stock"><?= $escaper->escapeHtml(__('Épuisé')) ?></span>
                    <?php endif; ?>
                </div>
            </li>
        <?php endforeach; ?>
    </ol>
</section>
<script type="text/x-magento-init">
    {"[data-role=tocart-form]": {"catalogAddToCart": {}}}
</script>
