<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="marwa_virtualtryon" translate="label" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Virtual Try-On</label>
            <tab>catalog</tab>
            <resource>Marwa_VirtualTryOn::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Virtual Try-On</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="show_on_listing" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Badge on Product Images</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="show_on_product_page" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Button on Product Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="badge_label" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Badge Label</label>
                </field>
                <field id="image_ids" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Image Types With Badge</label>
                    <comment>Comma-separated image IDs from view.xml, e.g. category_page_grid,new_products_content_widget_grid.</comment>
                </field>
            </group>

            <group id="fitting_room" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Fitting Room</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Fitting Room Link in Top Bar</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="label" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Link Label</label>
                </field>
            </group>

            <group id="camera" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Camera</label>
                <field id="facing_mode" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Camera</label>
                    <source_model>Marwa\VirtualTryOn\Model\Config\Source\FacingMode</source_model>
                </field>
                <field id="mirror" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Mirror Front Camera</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="api" translate="label comment" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>External Try-On API</label>
                <comment>When disabled, the fitting room only shows the live camera. When enabled, camera frames are sent through the store server to this endpoint; the API key never reaches the browser.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable API</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="endpoint" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Endpoint URL</label>
                    <comment>HTTPS URL. Receives JSON {frame, product}; must answer JSON {image} (data URL or HTTPS URL).</comment>
                    <validate>validate-url</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="interval_ms" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Frame Interval (ms)</label>
                    <comment>How often a camera frame is sent. Minimum 300.</comment>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Request Timeout (seconds)</label>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
