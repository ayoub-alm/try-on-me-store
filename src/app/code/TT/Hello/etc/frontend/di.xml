<?xml version="1.0"?>
<!--
    TemplateToaster's menu block is a subclass of Magento's Topmenu. Catalog adds the categories through its
    catalogTopmenu plugin on the parent class; declaring the same plugin (same name) for the subclass makes sure the
    compiled configuration of production mode applies it too.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="TT\Hello\Block\Html\Topmenu">
        <plugin name="catalogTopmenu" type="Magento\Catalog\Plugin\Block\Topmenu"/>
    </type>
</config>
